{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CaptureSession": {
    "TtlSeconds": 240,
    "MaxPhotoAgeSeconds": 120,
    "ClockSkewSeconds": 60,
    "SingleUse": true
  },
  "PhotoValidation": {
    "MinWidth": 1280,
    "MinHeight": 720,
    "MaxFileSizeBytes": 12582912,
    "AllowedContentTypes": [ "image/jpeg", "image/jpg", "image/heic", "image/heif" ],
    "RequireCameraExif": true,
    "RequirePhotoHash": false,
    "MaxGpsAccuracyMeters": 25,
    "MaxPhotoLocationDeltaMeters": 40,
    "MaxTiltDegrees": 20,
    "FallenTiltDegrees": 55,
    "MinPlateConfidence": 0.75,
    "MaxRetakeAttempts": 3
  },
  "Geofence": {
    "QueryRadiusMeters": 80,
    "EnforceServiceArea": true,
    "MaxParkingSuggestions": 3,
    "MaxAccuracyCompensationMeters": 10
  },
  "Vision": {
    "Endpoint": "",
    "ApiKey": "",
    "TimeoutSeconds": 8,
    "AllowClientHints": false
  },
  "PhotoStorage": {
    "RootPath": "App_Data/parking-photos",
    "Enabled": true
  }
}
